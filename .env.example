# ---- apps/api (copy to apps/api/.env) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nestself:nestself_dev@localhost:5432/nestself
DATABASE_POOL_MAX=10                  # pg Pool max connections (default 10)
AUTH_MODE=stub                    # stub | cognito (stub refused in production; D-36)
JWT_SECRET=change-me-to-at-least-32-characters-long-please
JWT_EXPIRES_IN=1h
REDIS_URL=redis://localhost:6379  # required for cognito; optional for stub
MARKETING_URL=http://localhost:3000
WORKSPACE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# API_PUBLIC_URL=https://api.nestself.rs
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
COGNITO_WEB_CLIENT_SECRET=
COGNITO_MOBILE_CLIENT_ID=
# SESSION_ENCRYPTION_KEY=          # openssl rand -hex 32; derived from JWT_SECRET in stub
TRUST_PROXY_HOPS=0
# FAKE_IDP_FIXED_OTP=123456

# ---- apps/workspace and apps/admin (copy to apps/<app>/.env.local) ----
VITE_API_URL=http://localhost:4000
VITE_DATA_SOURCE=sample            # sample | api  (sample renders fixtures and the sample banner)

# ---- apps/mobile (copy to apps/mobile/.env.local) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DATA_SOURCE=sample

# ---- apps/marketing (copy to apps/marketing/.env.local) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:5173
NEXT_PUBLIC_CONTACT_EMAIL=hello@nestself.example   # replace before launch
API_URL=http://localhost:4000                     # server-side; lead forms return 503 when unset
