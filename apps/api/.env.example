NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nestself:nestself_dev@localhost:5432/nestself
# pg Pool size for the API process. Migrations (`db:migrate`) run as the owner role;
# in Docker the API connects as `nestself_api` so row-level security applies (D-37).
DATABASE_POOL_MAX=10
# Integration tests (apps/api/test): a database the suites may drop and recreate.
# TEST_DATABASE_URL=postgresql://nestself:nestself_dev@localhost:5432/nestself_test

# --- Auth mode (D-36) ---
# stub: legacy HS256 guard (local dev, sample mode). Refused in production.
# cognito: real Cognito-backed sessions and bearer auth.
AUTH_MODE=stub

# --- Legacy stub auth (removed after cutover) ---
JWT_SECRET=change-me-to-at-least-32-characters-long-please
JWT_EXPIRES_IN=1h

# --- Redis / Valkey ---
# Required when AUTH_MODE=cognito. Optional in stub mode (memory store used when absent).
REDIS_URL=redis://localhost:6379

# --- Origins ---
# WORKSPACE_URL, ADMIN_URL and API_PUBLIC_URL are required when AUTH_MODE=cognito
# (SSO start URL, the Cognito callback /api/auth/sso/callback and the
# post-sign-in redirects are built from them); optional in stub mode, where
# they fall back to the localhost origins below.
MARKETING_URL=http://localhost:3000
WORKSPACE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:4000

# --- Cognito (fill in after cdk deploy) ---
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
COGNITO_WEB_CLIENT_SECRET=
COGNITO_MOBILE_CLIENT_ID=
# COGNITO_DOMAIN=https://auth.nestself.rs
# COGNITO_ISSUER=  # derived from region + pool id when absent

# --- Session encryption (generate with: openssl rand -hex 32) ---
# Required when AUTH_MODE=cognito. In stub mode, derived from JWT_SECRET if absent.
# SESSION_ENCRYPTION_KEY=
# IP_HASH_SALT=  # key for the audit and session IP hashes; defaults to SESSION_ENCRYPTION_KEY
# SESSION_ENCRYPTION_KEY_PREVIOUS=  # set during key rotation (dual acceptance)

# --- Cookie names (defaults shown) ---
# SESSION_COOKIE_NAME=__Host-nestself_session
# CSRF_COOKIE_NAME=__Host-nestself_csrf
# SESSION_COOKIE_INSECURE_DEV=true  # drop __Host- prefix and Secure in dev

# --- Session lifetime overrides (JSON, optional) ---
# SESSION_LIFETIME_OVERRIDES={"employee:personal":{"idleSeconds":600,"absoluteSeconds":3600}}

# --- Proxy: how many proxies stand in front of the API ---
# The client address every throttle counts is taken from X-Forwarded-For this
# many entries from the right. 0 on a laptop; 2 in AWS (CloudFront, then the
# load balancer), which the compute stack sets. Safe only while nothing but
# those proxies can reach the API (docs/auth/implementation.md section 17.2).
TRUST_PROXY_HOPS=0

# --- Fake identity provider (stub mode only) ---
# FAKE_IDP_FIXED_OTP=123456  # always-accepted OTP code for local testing; in stub mode it also
#                            # fixes the codes NestSelf mails itself (SSO users' step-up, the
#                            # confirm-email step), which are never written to the log

# --- Email ---
# SES_FROM_EMAIL is the verified SES sender of every mail the API sends itself:
# invitations, the codes NestSelf issues (SSO users' step-up, the confirm-email
# step of an SSO sign-in) and the ops alert. Cognito sends its own sign-in codes.
# Unset (and always under NODE_ENV=test), nothing is sent: the API logs the
# template, the locale and the recipient's domain at debug level, never the
# address, the link or the code. Outside production the response of a single
# invitation create (POST .../invitations, not the import) carries `devToken`,
# so the activation link can be built by hand:
# {WORKSPACE_URL}/invite/{devToken}
# SES_FROM_EMAIL=noreply@nestself.rs
# OPS_ALERT_EMAIL is the operations mailbox for alerts such as the SSO
# certificate expiry notice of the nightly job. Unset, they are logged, not mailed.
# OPS_ALERT_EMAIL=ops@nestself.rs

# --- Maintenance jobs (worker process: `pnpm --filter @nestself/api worker:dev`) ---
# Nightly audit partitions, grant reconciliation and stale mobile families run
# through BullMQ on REDIS_URL. Cron schedules are evaluated in this timezone.
# JOBS_TIMEZONE=Europe/Belgrade

# --- Video calls (NS-CALLS-01, D-CW-05, D-CW-06, D-CW-12) ---
# `none` (default) uses the in-process fake provider: no AWS call, and the worker
# applies the fake's meeting events in process. `chime` uses the Amazon Chime SDK
# and requires the four variables below (the API refuses to start without them).
# Blank values count as unset.
VIDEO_PROVIDER=none
# Must be eu-central-1 (data residency); any other value is refused (CW-R-68).
CHIME_REGION=
# From `node infra/cdk/scripts/env-from-outputs.mjs dev` once NestSelf-dev-Video is
# deployed. The worker long-polls the queue URL (chime.events.consume); the API
# passes the ARN to CreateMeeting as NotificationsConfiguration.SqsQueueArn.
CHIME_EVENTS_QUEUE_URL=
CHIME_EVENTS_QUEUE_ARN=
# Webinar recordings bucket (D-CW-18).
RECORDINGS_BUCKET=
# Deployment stage, tagged on provider resources (D-CW-11); the compute stack sets it.
# STAGE=dev
# Nightly real-provider smoke test, CI only.
# VIDEO_SMOKE_ENABLED=false
#
# Call jobs (worker process): calls.cleanup, calls.reconcile (every 5 minutes, in
# JOBS_TIMEZONE), appointment.remind and calls.no_show_followup run on the BullMQ
# queue `nestself-calls` on REDIS_URL; without REDIS_URL nothing is scheduled.
