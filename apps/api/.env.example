NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nestself:nestself_dev@localhost:5432/nestself
# pg Pool size for the API process. Migrations (`db:migrate`) run as the owner role;
# in Docker the API connects as `nestself_api` so row-level security applies (D-37).
DATABASE_POOL_MAX=10
# Integration tests (apps/api/test): a database the suites may drop and recreate.
# TEST_DATABASE_URL=postgresql://nestself:nestself_dev@localhost:5432/nestself_test

# --- Auth mode (D-36) ---
# stub: legacy HS256 guard (local dev, sample mode). Refused in production.
# cognito: real Cognito-backed sessions and bearer auth.
AUTH_MODE=stub

# --- Legacy stub auth (removed after cutover) ---
JWT_SECRET=change-me-to-at-least-32-characters-long-please
JWT_EXPIRES_IN=1h

# --- Redis / Valkey ---
# Required when AUTH_MODE=cognito. Optional in stub mode (memory store used when absent).
REDIS_URL=redis://localhost:6379

# --- Origins ---
# WORKSPACE_URL, ADMIN_URL and API_PUBLIC_URL are required when AUTH_MODE=cognito
# (SSO start URL, the Cognito callback /api/auth/sso/callback and the
# post-sign-in redirects are built from them); optional in stub mode, where
# they fall back to the localhost origins below.
MARKETING_URL=http://localhost:3000
WORKSPACE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:4000

# --- Cognito (fill in after cdk deploy) ---
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
COGNITO_WEB_CLIENT_SECRET=
COGNITO_MOBILE_CLIENT_ID=
# COGNITO_DOMAIN=https://auth.nestself.rs
# COGNITO_ISSUER=  # derived from region + pool id when absent

# --- Session encryption (generate with: openssl rand -hex 32) ---
# Required when AUTH_MODE=cognito. In stub mode, derived from JWT_SECRET if absent.
# SESSION_ENCRYPTION_KEY=
# IP_HASH_SALT=  # key for the audit and session IP hashes; defaults to SESSION_ENCRYPTION_KEY
# SESSION_ENCRYPTION_KEY_PREVIOUS=  # set during key rotation (dual acceptance)

# --- Cookie names (defaults shown) ---
# SESSION_COOKIE_NAME=__Host-nestself_session
# CSRF_COOKIE_NAME=__Host-nestself_csrf
# SESSION_COOKIE_INSECURE_DEV=true  # drop __Host- prefix and Secure in dev

# --- Session lifetime overrides (JSON, optional) ---
# SESSION_LIFETIME_OVERRIDES={"employee:personal":{"idleSeconds":600,"absoluteSeconds":3600}}

# --- Proxy (set to 1+ when behind a load balancer) ---
TRUST_PROXY_HOPS=0

# --- Fake identity provider (stub mode only) ---
# FAKE_IDP_FIXED_OTP=123456  # always-accepted OTP code for local testing

# --- Email ---
# SES_FROM_EMAIL=noreply@nestself.rs

# --- Maintenance jobs (worker process: `pnpm --filter @nestself/api worker:dev`) ---
# Nightly audit partitions, grant reconciliation and stale mobile families run
# through BullMQ on REDIS_URL. Cron schedules are evaluated in this timezone.
# JOBS_TIMEZONE=Europe/Belgrade
