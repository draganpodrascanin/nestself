    "fontOpticalSizing": "auto",
    "fontSynthesis": "none",
    "paragraphGap": 16,
    "readingWidthCh": 65,
    "readingTargetCharacters": [
      55,
      75
    ],
    "candidates": [
      {
        "id": "onest",
        "name": "Onest",
        "character": "Open, clear, balanced",
        "reason": "The strongest starting point for one consistent employee, public and HR experience.",
        "tradeoff": "No true italic in the delivered distribution. Use weight and layout for emphasis.",
        "weights": [
          400,
          600,
          700
        ],
        "italic": false,
        "numerals": "Enable tnum for tables.",
        "source": "https://github.com/simpals/onest"
      },
      {
        "id": "commissioner",
        "name": "Commissioner",
        "character": "Humanist, more characterful",
        "reason": "A warmer voice without serif headlines. Useful when brand expression should be stronger.",
        "tradeoff": "Keep the standard voice in controls. Do not mix Flare and Loud styles without a separate rule.",
        "weights": [
          400,
          600,
          700
        ],
        "italic": true,
        "numerals": "Author version 1.012 includes tnum.",
        "source": "https://github.com/kosbarts/Commissioner"
      },
      {
        "id": "nunito",
        "name": "Nunito Sans",
        "character": "Softer, approachable",
        "reason": "A friendlier employee experience, balanced by precise spacing and restrained shapes.",
        "tradeoff": "Avoid light weights and exaggerated rounded components.",
        "weights": [
          400,
          600,
          700
        ],
        "italic": true,
        "numerals": "The delivered regular has equal-width digits.",
        "source": "https://github.com/googlefonts/NunitoSans"
      },
      {
        "id": "fira",
        "name": "Fira Sans",
        "character": "Practical, strong in dense UI",
        "reason": "Distinct humanist forms for long lists, administration and day-to-day operations.",
        "tradeoff": "Large headlines can feel more technical. Let imagery and language carry the personal side.",
        "weights": [
          400,
          600,
          700
        ],
        "italic": true,
        "numerals": "Enable tnum for tables.",
        "source": "https://github.com/bBoxType/FiraSans"
      },
      {
        "id": "lato",
        "name": "Lato",
        "character": "Familiar, steady, human",
        "reason": "A calm long-term choice across prose, forms and tables.",
        "tradeoff": "Less visual distinction; the wider composition must do more of the brand work.",
        "weights": [
          400,
          600,
          700
        ],
        "italic": true,
        "numerals": "The delivered regular has equal-width digits.",
        "source": "https://www.latofonts.com/lato-free-fonts/"
      }
    ]
  },
  "layout": {
    "breakpoints": [
      {
        "min": 0,
        "max": 599,
        "columns": 4,
        "margin": 16,
        "gutter": 16
