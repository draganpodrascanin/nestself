    "form": {
      "fieldGap": {
        "web": 24,
        "touch": 20
      },
      "sectionGap": {
        "web": 32,
        "touch": 24
      }
    },
    "icons": {
      "family": "Phosphor",
      "interfaceWeight": "regular",
      "activeNavigationWeight": "fill",
      "categoryWeight": "duotone",
      "sizes": {
        "metadata": 16,
        "control": [
          20,
          24
        ],
        "category": [
          32,
          48
        ]
      },
      "webReactPackage": "@phosphor-icons/react",
      "native": "Use the same official SVG source via the native SVG pipeline. Verify adapters separately."
