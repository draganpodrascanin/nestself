  "accessibility": {
    "target": "WCAG 2.2 AA",
    "normalTextContrast": 4.5,
    "controlContrast": 3,
    "webInternalTarget": 44,
    "iosInternalTarget": 48,
    "androidInternalTarget": 48,
    "webReflowWidth": 320,
