      {
        "min": 1440,
        "max": null,
        "columns": 12,
        "margin": 40,
        "gutter": 24
      }
    ],
    "maxContent": {
      "marketing": 1280,
      "employee": 1120,
      "hr": 1440,
      "form": 640
    },
    "desktopSidebar": 248,
    "desktopTopbar": 72,
    "mobileBottomBar": 64,
    "safeArea": "add platform safe-area insets, never a fixed device notch value",
    "marketingHero": {
      "grid": "5 / 7 columns at full width; stack below 760px container width",
      "gap": 48,
      "photography": "lead family scene with two supporting moments",
      "maxContent": 1280
    }
  },
  "components": {
    "button": {
      "minHeight": {
        "web": 44,
        "mobileWeb": 48,
        "ios": 48,
        "android": 48
      },
      "paddingInline": 20,
      "gap": 8,
      "radius": "var(--radius-control)",
      "background": "var(--color-primary)",
      "foreground": "var(--color-on-primary)",
      "focus": {
        "width": 3,
        "offset": 2,
        "token": "var(--color-focus)"
      },
      "loading": "retain label and dimensions, prevent duplicate action"
    },
    "input": {
      "minHeight": 48,
      "denseHrWebMinHeight": 44,
      "paddingInline": 12,
      "labelGap": 8,
      "helperGap": 8,
      "radius": "var(--radius-control)",
      "border": "var(--color-border-control)",
      "invalidBorder": "var(--color-danger)",
      "invalidBorderWidth": 2
    },
    "card": {
      "padding": {
        "web": 24,
        "mobileWeb": 20,
        "ios": 20,
        "android": 20
      },
