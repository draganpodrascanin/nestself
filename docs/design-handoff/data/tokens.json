    "artDirection": {
      "light": "natural soft daylight",
      "whiteBalance": "neutral, true skin tones",
      "avoid": [
        "beige filter",
        "petrol skin toning",
        "beauty retouch",
        "staged distress",
        "forced corporate joy",
        "lotus/spa clichés",
        "invented expert or user identity"
      ]
    },
    "crop": {
      "portraitEyesHeightPercent": [
        35,
        45
      ],
      "preserve": [
        "eyes",
        "chin",
        "important hands",
        "meaningful context"
      ],
      "responsive": "editorial crop or separate mobile source when automatic cover loses meaning",
      "focalPoint": "CMS focalX / focalY in normalized 0..1"
    },
    "text": {
      "default": "separate solid panel",
      "overPhoto": "quiet negative space outside faces, verify actual crop contrast",
      "contrastMinimum": 4.5,
      "inset": {
        "web": 24,
        "mobile": 16
      },
      "bakedIntoImage": false
    },
    "delivery": {
      "hero": {
        "longEdge": [
          1600,
          2000
        ],
        "targetKB": 200
      },
      "portrait": {
        "width": 800,
        "height": 1000,
        "targetKB": 150
      },
      "avatar": {
        "width": 320,
        "height": 320,
        "targetKB": 35
      },
      "article": {
        "width": 1200,
        "height": 675,
        "targetKB": 120
      },
      "card": {
        "width": 800,
        "height": 450,
        "targetKB": 80
      },
      "web": "AVIF/WebP with fallback, srcset and explicit aspect ratio; lazy below fold",
      "native": "Use codecs and caching supported by the app; no automatic format assumption",
      "budgets": "starting targets, keep sufficient visual quality"
    },
    "requiredMetadata": [
      "role",
      "sourceUrl",
      "photographer",
      "license",
      "approvalScope",
      "altByContext",
      "focalX",
      "focalY",
      "cropVariants"
    ],
    "accessibility": {
      "informative": "describe relevant context",
      "decorative": "empty alt",
      "functional": "name action/destination",
      "portraitWithVisibleName": "avoid redundant repetition"
    },
    "rights": "Record source, author, license and appropriate permissions. Lifestyle people are illustrative, never named experts, customers or endorsements. Family imagery does not imply family-member eligibility.",
    "samples": "Presentation stock photos are art-direction examples only. No raw stock source files are redistributed in this handoff."
  },
