{
  "name": "nestself",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run check",
    "verify": "pnpm lint && pnpm lint:root && pnpm typecheck && pnpm test && pnpm check && pnpm build",
    "e2e": "playwright test",
    "e2e:auth": "playwright test -c playwright.auth.config.ts --project auth-desktop",
    "docs:auth:screenshots": "playwright test -c playwright.auth.config.ts --project screenshots",
    "docs:auth:pdf": "node docs/auth/pdf/build.mjs docs/auth/implementation.md docs/auth/implementation.pdf && node docs/auth/pdf/build.mjs docs/auth/quick-guide.md docs/auth/quick-guide.pdf",
    "e2e:content": "playwright test -c playwright.content.config.ts",
    "e2e:motion": "playwright test -c playwright.motion.config.ts",
    "e2e:calls": "playwright test -c playwright.calls.config.ts",
    "e2e:update": "playwright test --update-snapshots",
    "storybook": "pnpm --filter @nestself/ui dev",
    "images:build": "pnpm --filter @nestself/assets build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "sherif",
    "db:up": "docker compose -f docker/docker-compose.yml up -d postgres redis",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "docker:api": "docker compose -f docker/docker-compose.yml --profile api up --build",
    "lint:root": "eslint e2e playwright.config.ts playwright.auth.config.ts playwright.content.config.ts playwright.motion.config.ts playwright.calls.config.ts eslint.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@nestself/eslint-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@prisma/client": "-",
      "prisma": "-"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher",
      "core-js",
      "sharp",
      "@scarf/scarf"
    ]
  },
  "type": "module"
}
