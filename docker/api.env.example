# NestSelf API environment for Docker Compose.
# Copy this file to docker/api.env and fill in real values before running `pnpm docker:api`.

JWT_SECRET=change-me-to-at-least-32-characters-long-please
MARKETING_URL=http://localhost:3000
WORKSPACE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
NODE_ENV=production
PORT=4000
