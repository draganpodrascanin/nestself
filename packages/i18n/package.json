{
  "name": "@nestself/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./transliterate": "./src/transliterate.ts",
    "./locales/*": "./locales/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node scripts/check-locales.mjs",
    "build:cyrillic": "node scripts/transliterate.mjs --write"
  },
  "dependencies": {
    "i18next": "catalog:"
  },
  "devDependencies": {
    "@nestself/contracts": "workspace:*",
    "@nestself/eslint-config": "workspace:*",
    "@nestself/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
